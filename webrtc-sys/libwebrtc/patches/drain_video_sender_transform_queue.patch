 TEST_F(RtpSenderVideoFrameTransformerDelegateTest,
+       ResetReleasesQueuedFramesBeforeReturning) {
+  struct TrackedFrame : MockTransformableVideoFrame {
+    explicit TrackedFrame(bool& released) : released(released) {}
+    ~TrackedFrame() override { released = true; }
+    bool& released;
+  };
+  bool queued_released = false;
+  bool late_released = false;
+  auto delegate = make_ref_counted<RTPSenderVideoFrameTransformerDelegate>(
+      &test_sender_, frame_transformer_, /*ssrc=*/1111, /*rid=*/"rid",
+      time_controller_.CreateTaskQueueFactory().get());
+  scoped_refptr<TransformedFrameCallback> callback;
+  EXPECT_CALL(*frame_transformer_, RegisterTransformedFrameSinkCallback)
+      .WillOnce(SaveArg<0>(&callback));
+  EXPECT_CALL(*frame_transformer_, UnregisterTransformedFrameSinkCallback(1111));
+  EXPECT_CALL(test_sender_, SendVideo).Times(0);
+  delegate->Init();
+  ASSERT_TRUE(callback);
+
+  callback->OnTransformedFrame(std::make_unique<TrackedFrame>(queued_released));
+  EXPECT_FALSE(queued_released);
+  delegate->Reset();
+  EXPECT_TRUE(queued_released);
+  callback->OnTransformedFrame(std::make_unique<TrackedFrame>(late_released));
+  EXPECT_TRUE(late_released);
+
+  // Keep the sender and callback references alive through simulated cleanup.
+  time_controller_.AdvanceTime(TimeDelta::Zero());
+}
